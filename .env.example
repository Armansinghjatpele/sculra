# ==============================================================================
# Sculra Enterprise Environment Variables Template
# ==============================================================================
# Copy this file to .env.local (frontend) or .env (root/backend) and fill in the values.
# Variables are categorized into: REQUIRED, OPTIONAL, and FUTURE.

# ==============================================================================
# 1. REQUIRED ENVIRONMENTS (Must be configured for basic local startup)
# ==============================================================================

# General / App Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development # development | test | preview | production

# Clerk Authentication (Responsible for all User Auth, Sessions, OAuth, etc.)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Supabase (Database, Storage buckets, Database functions, RLS)
# NOTE: Supabase Auth is NOT used.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==============================================================================
# 2. OPTIONAL ENVIRONMENTS (Local feature gates - can be omitted in basic dev)
# ==============================================================================

# Clerk Webhook Secret (For syncing users metadata with Supabase DB)
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_public_api_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry Errors Monitoring & Performance
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# AI Inference APIs
OPENAI_API_KEY=sk-proj-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
GOOGLE_AI_API_KEY=AIzaSyYourGoogleAIApiKey

# Stripe Payments
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_pub_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# GitHub Integration
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_APP_ID=your-github-app-id
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# ==============================================================================
# 3. FUTURE ENVIRONMENTS (Not required for local development - used for deployment scaling)
# ==============================================================================

# Distributed Caching & Event Queueing (Redis)
REDIS_URL=redis://:password@your-redis-host:6379

# Cloudflare Integration (DNS, CDN, WAF, Edge Rate Limiting protection)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
